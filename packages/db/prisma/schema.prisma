generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Conventions (see docs/M1-org-patients.md):
//  - Every table except Tenant is tenant-owned (`tenantId`), FORCE RLS + `tenant_isolation` policy.
//  - Relations between tenant-owned rows use COMPOSITE foreign keys `(tenantId, xId) -> X(tenantId, id)`
//    so a row can never reference another tenant's row, even with a guessed UUID (FK checks bypass RLS).
//  - Money is integer paise (`...Paise`). User ids are the IdP subject (`String`), as in Membership.
//  - Effective-dated rows (`effectiveFrom`/`effectiveTo`, `effectiveTo` exclusive, NULL = open) keep history:
//    close the open row and insert a new one; never rewrite past rows.

enum Role {
  OWNER
  MANAGER
  DENTIST
  RECEPTIONIST
  ACCOUNTANT
  PATIENT
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum Sex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PatientLifecycleStage {
  REGISTERED
  ACTIVE
  IN_TREATMENT
  FOLLOW_UP
  RECALL
  INACTIVE
}

enum IntakeType {
  APPOINTMENT
  WALK_IN
  URGENT
  ENQUIRY
}

enum IdentityVerificationMethod {
  IN_PERSON_DOCUMENT
  OTP_PHONE
  OTP_EMAIL
  GUARDIAN
}

enum EnquirySource {
  WALK_IN
  PHONE
  WEBSITE
  WHATSAPP
  REFERRAL
  SOCIAL
  CAMPAIGN
  OTHER
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum Severity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum ConsentStatus {
  GRANTED
  DECLINED
  WITHDRAWN
}

enum CommChannel {
  SMS
  WHATSAPP
  EMAIL
  VOICE
}

enum CommPurpose {
  TRANSACTIONAL
  REMINDER
  MARKETING
}

enum DocumentCategory {
  ID_PROOF
  CONSENT_FORM
  REFERRAL
  LAB_REPORT
  XRAY
  PHOTO
  PRESCRIPTION
  INSURANCE
  OTHER
}

enum DocumentStatus {
  PENDING_UPLOAD
  AVAILABLE
  DELETED
}

enum DuplicateStatus {
  PENDING
  DISMISSED
  MERGED
}

// --- M2 clinical operations (ADR 0003: state machines are proposed defaults, pending sign-off) ---

enum WorkingHoursScope {
  BRANCH
  DENTIST
  CHAIR
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_CHAIR
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentSource {
  SCHEDULED
  WALK_IN
  URGENT
}

enum EncounterStatus {
  OPEN
  SIGNED
}

enum ClinicalNoteKind {
  SUBJECTIVE
  OBJECTIVE
  ASSESSMENT
  PLAN
  GENERAL
}

enum Dentition {
  PERMANENT
  PRIMARY
}

enum ToothRecordStatus {
  CURRENT
  HISTORICAL
}

enum ProcedureStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum TreatmentPlanStatus {
  DRAFT
  PRESENTED
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PlanItemStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  DEFERRED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PlanItemSessionStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ConsentTemplateType {
  TREATMENT_PLAN
  PROCEDURE
  RADIOGRAPH
  CLINICAL_PHOTOGRAPHY
  COMMUNICATION
}

// --- M3 business operations (ADR 0004: rules are proposed defaults, pending sign-off) ---

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  WALLET
  OTHER
}

enum PaymentStatus {
  RECORDED
  PENDING
  FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum AdjustmentKind {
  CREDIT
  DEBIT
}

enum LedgerEntryKind {
  INVOICE
  INVOICE_VOID
  PAYMENT
  REFUND
  CREDIT_NOTE
  DEBIT_NOTE
}

enum CreditEntryKind {
  ADVANCE
  APPLIED
  REFUNDED
  ADJUSTMENT
}

enum CommissionRuleType {
  PERCENT_OF_COLLECTED
  PERCENT_OF_BILLED
  FIXED_PER_PROCEDURE
}

enum CommissionEntryKind {
  ACCRUAL
  REVERSAL
  ADJUSTMENT
  SETTLEMENT
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
}

enum InventoryUnit {
  PIECE
  BOX
  PACK
  SET
  VIAL
  CARTRIDGE
  GRAM
  KILOGRAM
  MILLILITRE
  LITRE
}

enum CostingMethod {
  WEIGHTED_AVERAGE
}

enum StockMovementKind {
  RECEIPT
  CONSUMPTION
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  WASTE
}

enum StockTransferStatus {
  IN_TRANSIT
  RECEIVED
}

/// M4 (ADR 0005): portal account lifecycle. INVITED -> ACTIVE (patient completed OTP) <-> SUSPENDED.
enum PortalAccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// M4: why an OTP was issued. STEP_UP / CONTACT_VERIFY are bound to an ACTIVE account.
enum PortalOtpPurpose {
  LOGIN
  ACTIVATE
  STEP_UP
  CONTACT_VERIFY
}

/// M4: AI drafts leave DRAFT exactly once (DB trigger), then are frozen.
enum AiDraftStatus {
  DRAFT
  APPROVED
  REJECTED
  EXPIRED
}

/// M4: the draft-producing approved capabilities (PRD 5.2 #1-#5; #6/#7 are not drafts).
enum AiDraftKind {
  PATIENT_HISTORY_SUMMARY
  ENCOUNTER_SUMMARY
  CLINICAL_NOTE
  VOICE_NOTE
  PLAN_EXPLANATION
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED_NO_CONSENT
  OPTED_OUT
}

model Tenant {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  /// Organisation settings (display, defaults). Not for secrets.
  settings              Json                   @default("{}")
  onboardingStatus      OnboardingStatus       @default(PENDING)
  onboardedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  branches              Branch[]
  members               Membership[]
  invitations           StaffInvitation[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  patients              Patient[]
  consentTemplates      ConsentTemplate[]
  inventoryItems        InventoryItem[]
  suppliers             Supplier[]
  notificationTemplates NotificationTemplate[]
  commissionRules       CommissionRule[]
  commissionSettlements CommissionSettlement[]
}

model Branch {
  id                 String                    @id @default(uuid()) @db.Uuid
  tenantId           String                    @db.Uuid
  /// Short human code, unique per tenant (e.g. "BLR-01"). Stored upper-case.
  code               String
  name               String
  active             Boolean                   @default(true)
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String                    @default("IN")
  phone              String?
  email              String?
  /// IANA zone, e.g. "Asia/Kolkata".
  timezone           String                    @default("Asia/Kolkata")
  /// { mon: [{ open: "09:00", close: "13:00" }, ...], ... } — see @dentalos/validation `workingHours`.
  workingHours       Json                      @default("{}")
  /// Branch-level knobs, e.g. { scheduling: { noShowGraceMinutes: 15 } } — see @dentalos/validation `branchSettings`.
  settings           Json                      @default("{}")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @default(now()) @updatedAt
  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  dentistAssignments DentistBranchAssignment[]
  priceOverrides     BranchPriceOverride[]
  originPatients     Patient[]
  enquiries          PatientEnquiry[]
  documents          PatientDocument[]
  medicalHistories   PatientMedicalHistory[]
  consents           PatientConsent[]
  chairs             Chair[]
  scheduleHours      WorkingHours[]
  appointments       Appointment[]
  encounters         Encounter[]
  treatmentPlans     TreatmentPlan[]
  invoiceCounters    InvoiceCounter[]
  invoices           Invoice[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  refunds            Refund[]
  adjustments        InvoiceAdjustment[]
  ledgerEntries      FinanceLedgerEntry[]
  creditEntries      PatientCreditEntry[]
  commissionEntries  CommissionEntry[]
  stockMovements     StockMovement[]
  stockBalances      StockBalance[]
  stockReceipts      StockReceipt[]
  transfersOut       StockTransfer[]           @relation("TransferFrom")
  transfersIn        StockTransfer[]           @relation("TransferTo")
  notifications      NotificationOutbox[]
  aiDrafts           AiDraft[]
  aiActivity         AiActivityLog[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Membership {
  id                 String                    @id @default(uuid()) @db.Uuid
  tenantId           String                    @db.Uuid
  userId             String
  /**
   * A user may hold several roles (e.g. owner who also treats patients); permissions are the union.
   */
  roles              Role[]
  /**
   * Organisation-wide access. When false, access is limited to `branchScope`.
   */
  orgWide            Boolean                   @default(false)
  branchScope        String[]                  @default([])
  /// Display name / e-mail for staff lists (M2 carry-over). E-mail is lower-cased (DB CHECK).
  displayName        String?
  email              String?
  /// Soft removal (0007): the row survives for attribution/history; roles and scope are cleared
  /// (DB CHECK). A new invitation restores the member and clears both columns.
  removedAt          DateTime?                 @db.Timestamptz(3)
  removedBy          String?
  createdAt          DateTime                  @default(now())
  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  dentistAssignments DentistBranchAssignment[]

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  branchId   String?  @db.Uuid
  actorId    String
  action     String
  resource   String
  resourceId String?
  outcome    String
  source     String
  createdAt  DateTime @default(now())
  /// Tamper-evidence: per-tenant hash chain filled by the audit_chain trigger; never set by the app.
  chainPos   BigInt?
  prevHash   String?
  hash       String?

  @@unique([tenantId, chainPos])
  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------------------------
// Organisation: staff invitations and dentist ↔ branch assignments
// ---------------------------------------------------------------------------------------------

/// Pending staff invite. Only a SHA-256 hash of the token is stored; the raw token goes in the link.
/// At most one PENDING invite per (tenant, email) — partial unique index in SQL.
model StaffInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  /// Lower-cased, trimmed.
  email       String
  roles       Role[]
  orgWide     Boolean          @default(false)
  branchScope String[]         @default([])
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  invitedBy   String
  acceptedBy  String?
  acceptedAt  DateTime?
  revokedBy   String?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
}

/// Effective-dated. A transfer closes the open row (effectiveTo = transfer date) and opens a new one;
/// history is never rewritten (PRD 2.5). One OPEN row per (dentist, branch) — partial unique index in SQL.
model DentistBranchAssignment {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  userId        String
  branchId      String     @db.Uuid
  effectiveFrom DateTime   @db.Date
  /// Exclusive. NULL = current.
  effectiveTo   DateTime?  @db.Date
  createdBy     String
  createdAt     DateTime   @default(now())
  member        Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Restrict)
  branch        Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, branchId])
}

// ---------------------------------------------------------------------------------------------
// Service catalogue and pricing
// ---------------------------------------------------------------------------------------------

model ServiceCategory {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  name            String
  sortOrder       Int              @default(0)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  services        Service[]
  invoiceLines    InvoiceLine[]
  commissionRules CommissionRule[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Service {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  categoryId     String?               @db.Uuid
  /// Unique per tenant, upper-case (e.g. "RCT-MOLAR").
  code           String
  name           String
  description    String?
  durationMin    Int
  /// Central price in paise (₹1 = 100 paise). Branch overrides live in BranchPriceOverride.
  basePricePaise Int
  taxable        Boolean               @default(false)
  /// M3: GST classification (HSN for goods / SAC for services, 4–8 digits) and rate in basis points
  /// (1800 = 18%). Both optional; billing falls back to Tenant.settings.billing defaults (ADR 0004).
  hsnSac         String?
  gstRateBp      Int?
  /// M4 (ADR 0005 §3): patients may book this service in the portal. Opt-in, default false.
  portalBookable Boolean               @default(false)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  category       ServiceCategory?      @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  priceOverrides BranchPriceOverride[]
  planItems      PlanItem[]
  procedures     ProcedureRecord[]
  invoiceLines   InvoiceLine[]
  recallSetting  RecallSetting?

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId(ops: raw("uuid_ops")), name(ops: raw("gin_trgm_ops"))], map: "Service_name_trgm_idx", type: Gin)
}

/// Effective-dated, audited branch price. One OPEN row (effectiveTo IS NULL) per (service, branch) —
/// partial unique index in SQL. Changing a price closes the open row and inserts a new one.
model BranchPriceOverride {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  serviceId     String    @db.Uuid
  branchId      String    @db.Uuid
  pricePaise    Int
  reason        String
  setBy         String
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  /// Why/by whom the override was closed (superseded or cleared).
  endedReason   String?
  endedBy       String?
  createdAt     DateTime  @default(now())
  service       Service   @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  branch        Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, serviceId])
}

// ---------------------------------------------------------------------------------------------
// Patients (shared across the tenant's branches, PRD 2.4)
// ---------------------------------------------------------------------------------------------

model Patient {
  id                         String                      @id @default(uuid()) @db.Uuid
  tenantId                   String                      @db.Uuid
  /// Branch where the patient was first registered. Never changes.
  originBranchId             String                      @db.Uuid
  /// Optional human-readable patient number, unique per tenant.
  mrn                        String?
  firstName                  String
  middleName                 String?
  lastName                   String?
  preferredName              String?
  dob                        DateTime?                   @db.Date
  sex                        Sex                         @default(UNKNOWN)
  /// E.164, e.g. "+919876543210".
  phone                      String?
  altPhone                   String?
  email                      String?
  addressLine1               String?
  addressLine2               String?
  city                       String?
  state                      String?
  postalCode                 String?
  country                    String                      @default("IN")
  /// App-maintained via @dentalos/validation normalisers; used for search + duplicate matching.
  nameNormalized             String
  phoneNormalized            String?
  emailNormalized            String?
  lifecycleStage             PatientLifecycleStage       @default(REGISTERED)
  intakeType                 IntakeType
  /// Set when this record was merged into another (this row is then a read-only tombstone).
  mergedIntoId               String?                     @db.Uuid
  mergedAt                   DateTime?
  identityVerifiedAt         DateTime?
  identityVerifiedBy         String?
  identityVerificationMethod IdentityVerificationMethod?
  /// e.g. "AADHAAR", "PAN", "PASSPORT", "DL". Never store full government id numbers.
  identityDocumentType       String?
  identityDocumentLast4      String?
  createdBy                  String
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @default(now()) @updatedAt
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])
  originBranch               Branch                      @relation(fields: [tenantId, originBranchId], references: [tenantId, id], onDelete: Restrict)
  mergedInto                 Patient?                    @relation("PatientMerge", fields: [tenantId, mergedIntoId], references: [tenantId, id], onDelete: Restrict)
  mergedFrom                 Patient[]                   @relation("PatientMerge")
  enquiries                  PatientEnquiry[]
  medicalHistories           PatientMedicalHistory[]
  allergies                  PatientAllergy[]
  alerts                     PatientAlert[]
  consents                   PatientConsent[]
  communicationPreferences   CommunicationPreference[]
  documents                  PatientDocument[]
  mergesAsSurvivor           PatientMergeRecord[]        @relation("MergeSurvivor")
  mergesAsMerged             PatientMergeRecord[]        @relation("MergeMerged")
  duplicatesAsA              DuplicateCandidate[]        @relation("DuplicateA")
  duplicatesAsB              DuplicateCandidate[]        @relation("DuplicateB")
  appointments               Appointment[]
  encounters                 Encounter[]
  toothRecords               ToothRecord[]
  diagnoses                  Diagnosis[]
  procedures                 ProcedureRecord[]
  treatmentPlans             TreatmentPlan[]
  invoices                   Invoice[]
  invoiceLines               InvoiceLine[]
  payments                   Payment[]
  paymentAllocations         PaymentAllocation[]
  refunds                    Refund[]
  adjustments                InvoiceAdjustment[]
  ledgerEntries              FinanceLedgerEntry[]
  creditEntries              PatientCreditEntry[]
  notifications              NotificationOutbox[]
  portalAccount              PatientPortalAccount?
  portalSignatures           PortalConsentSignature[]
  aiDrafts                   AiDraft[]
  aiActivity                 AiActivityLog[]

  @@unique([tenantId, id])
  @@unique([tenantId, mrn])
  @@index([tenantId])
  @@index([tenantId, originBranchId])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, emailNormalized])
  @@index([tenantId, dob])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId(ops: raw("uuid_ops")), nameNormalized(ops: raw("gin_trgm_ops"))], map: "Patient_name_trgm_idx", type: Gin)
  @@index([tenantId(ops: raw("uuid_ops")), phoneNormalized(ops: raw("gin_trgm_ops"))], map: "Patient_phone_trgm_idx", type: Gin)
}

/// Lightweight lead (not a CRM, PRD 4.2).
model PatientEnquiry {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @db.Uuid
  branchId           String?       @db.Uuid
  name               String
  phone              String?
  phoneNormalized    String?
  email              String?
  source             EnquirySource
  areaOfInterest     String?
  notes              String?
  status             EnquiryStatus @default(NEW)
  convertedPatientId String?       @db.Uuid
  convertedAt        DateTime?
  createdBy          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt
  branch             Branch?       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  convertedPatient   Patient?      @relation(fields: [tenantId, convertedPatientId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId(ops: raw("uuid_ops")), name(ops: raw("gin_trgm_ops"))], map: "PatientEnquiry_name_trgm_idx", type: Gin)
}

/// Append-only, versioned (UPDATE/DELETE revoked from the app role). New version = new row.
model PatientMedicalHistory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  patientId   String   @db.Uuid
  branchId    String?  @db.Uuid
  version     Int
  medical     Json     @default("{}")
  dental      Json     @default("{}")
  medications Json     @default("[]")
  notes       String?
  recordedBy  String
  recordedAt  DateTime @default(now())
  patient     Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  branch      Branch?  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, patientId, version])
  @@index([tenantId])
}

model PatientAllergy {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  patientId        String    @db.Uuid
  substance        String
  reaction         String?
  severity         Severity  @default(MODERATE)
  active           Boolean   @default(true)
  notedBy          String
  notedAt          DateTime  @default(now())
  resolvedBy       String?
  resolvedAt       DateTime?
  resolutionReason String?
  patient          Patient   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, patientId])
}

model PatientAlert {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  patientId        String    @db.Uuid
  title            String
  details          String?
  severity         Severity
  active           Boolean   @default(true)
  createdBy        String
  createdAt        DateTime  @default(now())
  resolvedBy       String?
  resolvedAt       DateTime?
  resolutionReason String?
  patient          Patient   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, patientId])
}

model PatientConsent {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @db.Uuid
  patientId          String                   @db.Uuid
  branchId           String?                  @db.Uuid
  /// Consent type code — see @dentalos/validation `CONSENT_TYPES` (PRD 12.2: catalogue still evolving).
  type               String
  version            String
  status             ConsentStatus
  /// "DIGITAL" | "PAPER" | "VERBAL"
  method             String?
  documentId         String?                  @db.Uuid
  capturedBy         String
  grantedAt          DateTime?
  withdrawnAt        DateTime?
  withdrawalReason   String?
  /// M2: consent signed against a versioned template (and, for TREATMENT_PLAN, a plan version of
  /// the SAME patient — composite FK). Template-only types require templateVersionId (DB CHECK).
  /// Merges leave plan-linked consents on the original patient id (read via lineage).
  templateVersionId  String?                  @db.Uuid
  planVersionId      String?                  @db.Uuid
  /// Who signed: the patient or a guardian/representative (minors). "SELF" | "GUARDIAN" | "REPRESENTATIVE".
  signerName         String?
  signerRelationship String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @default(now()) @updatedAt
  patient            Patient                  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  branch             Branch?                  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  templateVersion    ConsentTemplateVersion?  @relation(fields: [tenantId, templateVersionId], references: [tenantId, id], onDelete: Restrict)
  planVersion        TreatmentPlanVersion?    @relation(fields: [tenantId, planVersionId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  portalSignatures   PortalConsentSignature[]

  /// M4: lets a portal e-signature prove it belongs to the consent's patient.
  @@unique([tenantId, id, patientId])
  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, templateVersionId])
  @@index([tenantId, planVersionId])
}

model CommunicationPreference {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  patientId String      @db.Uuid
  channel   CommChannel
  purpose   CommPurpose @default(TRANSACTIONAL)
  optIn     Boolean
  updatedBy String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  patient   Patient     @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, patientId, channel, purpose])
  @@index([tenantId])
}

/// Object lives in S3 under the tenant prefix (StorageService). Soft-deleted only.
model PatientDocument {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  patientId       String           @db.Uuid
  branchId        String           @db.Uuid
  storageKey      String           @unique
  fileName        String
  contentType     String
  sizeBytes       Int
  sha256          String?
  category        DocumentCategory @default(OTHER)
  description     String?
  status          DocumentStatus   @default(PENDING_UPLOAD)
  uploadedBy      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  deletedBy       String?
  deletedAt       DateTime?
  deletedReason   String?
  /// M2: X-ray / photo attached to an encounter of the SAME patient (composite FK). Merges leave
  /// encounter-attached documents on the original patient id with their encounter (read via lineage).
  encounterId     String?          @db.Uuid
  /// M4 (ADR 0005 §3): the patient may see / download this document in the portal. Off by default;
  /// only staff flip it (who + when recorded, DB CHECK). Never ID_PROOF.
  portalVisible   Boolean          @default(false)
  portalVisibleBy String?
  portalVisibleAt DateTime?        @db.Timestamptz(3)
  patient         Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  branch          Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  encounter       Encounter?       @relation(fields: [tenantId, encounterId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, branchId])
  @@index([tenantId, encounterId])
}

/// Append-only (UPDATE/DELETE revoked from the app role). `snapshot` holds both records pre-merge.
model PatientMergeRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  survivorId           String   @db.Uuid
  mergedId             String   @db.Uuid
  duplicateCandidateId String?  @db.Uuid
  performedBy          String
  approvedBy           String?
  reason               String
  snapshot             Json
  createdAt            DateTime @default(now())
  survivor             Patient  @relation("MergeSurvivor", fields: [tenantId, survivorId], references: [tenantId, id], onDelete: Restrict)
  merged               Patient  @relation("MergeMerged", fields: [tenantId, mergedId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, survivorId])
  @@index([tenantId, mergedId])
}

/// Canonical pair ordering: patientAId < patientBId (CHECK in SQL), unique per tenant.
model DuplicateCandidate {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid
  patientAId   String          @db.Uuid
  patientBId   String          @db.Uuid
  /// 0–100.
  score        Int
  reasons      Json            @default("[]")
  status       DuplicateStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewReason String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  patientA     Patient         @relation("DuplicateA", fields: [tenantId, patientAId], references: [tenantId, id], onDelete: Restrict)
  patientB     Patient         @relation("DuplicateB", fields: [tenantId, patientBId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, patientAId, patientBId])
  @@index([tenantId])
  @@index([tenantId, status])
}

// =============================================================================================
// M2 — Clinical operations (PRD 3.4, 4.3–4.5, 7.5). Rules: docs/adr/0003-clinical-domain-rules.md
// (proposed defaults, pending product sign-off). Hand-written SQL in 0006_m2_clinical adds the
// btree_gist exclusion constraints, CHECKs, append-only grants and the signed-encounter triggers.
// User ids (dentist, author, actor) are IdP subjects (text), deliberately NOT foreign keys to
// Membership: attribution must survive a member being removed (PRD 2.5). Dentist columns are
// checked against Membership when written (trigger tenant_member_guard).
// Every link between two patient-owned rows carries patientId in its composite FK, so one
// patient's rows can never be attached to another patient's (PlanItem, TreatmentPlanVersion and
// PlanItemSession copy patientId from their plan for that reason).
// =============================================================================================

// ---------------------------------------------------------------------------------------------
// Scheduling: chairs, working hours, appointments
// ---------------------------------------------------------------------------------------------

/// Dental chair / operatory. Deactivated, never deleted (DELETE revoked from the app role).
model Chair {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  branchId     String         @db.Uuid
  /// Upper-case (DB CHECK), unique per branch (e.g. "OP-1").
  code         String
  name         String
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  branch       Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  workingHours WorkingHours[]
  appointments Appointment[]

  @@unique([tenantId, id])
  /// Lets children prove "this chair belongs to that branch" with one composite FK.
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, code])
  @@index([tenantId])
  @@index([tenantId, branchId])
}

/// Effective-dated weekly sessions for a branch, a dentist (at a branch) or a chair. Several
/// sessions per weekday are allowed (e.g. 09:00–13:00 and 17:00–21:00); overlapping open sessions
/// for the same subject are rejected by an exclusion constraint. Change = close the open rows
/// (effectiveTo) and insert new ones; never rewrite past rows.
model WorkingHours {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  scope         WorkingHoursScope
  branchId      String            @db.Uuid
  /// Required iff scope = DENTIST (IdP subject; must be a tenant member when set — trigger).
  userId        String?
  /// Required iff scope = CHAIR; must belong to `branchId` (composite FK).
  chairId       String?           @db.Uuid
  /// 0 = Sunday … 6 = Saturday (JS Date#getDay / Postgres EXTRACT(DOW)), in the branch time zone.
  weekday       Int               @db.SmallInt
  /// Minutes after local midnight, [startMinute, endMinute).
  startMinute   Int               @db.SmallInt
  endMinute     Int               @db.SmallInt
  effectiveFrom DateTime          @db.Date
  /// Exclusive. NULL = open.
  effectiveTo   DateTime?         @db.Date
  createdBy     String
  createdAt     DateTime          @default(now())
  branch        Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  chair         Chair?            @relation(fields: [tenantId, branchId, chairId], references: [tenantId, branchId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, branchId, scope])
  @@index([tenantId, userId])
  @@index([tenantId, chairId])
}

/// One booked visit. Reschedule = mark this row RESCHEDULED and insert a new row whose
/// `rescheduledFromId` points here (history kept). Double-booking a dentist or chair among
/// active statuses is rejected by exclusion constraints (SQLSTATE 23P01 -> 409 slot_conflict).
model Appointment {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  patientId          String             @db.Uuid
  branchId           String             @db.Uuid
  /// NULL = unassigned (PRD 4.3). Must be a tenant member when set (trigger).
  dentistUserId      String?
  /// Must belong to `branchId` (composite FK).
  chairId            String?            @db.Uuid
  /// See @dentalos/validation `APPOINTMENT_TYPES` (text so the catalogue can grow without a migration).
  appointmentType    String
  startsAt           DateTime           @db.Timestamptz(3)
  endsAt             DateTime           @db.Timestamptz(3)
  status             AppointmentStatus  @default(BOOKED)
  source             AppointmentSource  @default(SCHEDULED)
  rescheduledFromId  String?            @db.Uuid
  /// Same patient's plan item (composite FK).
  planItemId         String?            @db.Uuid
  /// Required when status = CANCELLED (DB CHECK).
  cancelReason       String?
  /// Booking outside working hours needs `schedule:manage` and this reason (ADR 0003).
  outsideHoursReason String?
  notes              String?
  checkedInAt        DateTime?
  createdBy          String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  patient            Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  branch             Branch             @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  chair              Chair?             @relation(fields: [tenantId, branchId, chairId], references: [tenantId, branchId, id], onDelete: Restrict)
  rescheduledFrom    Appointment?       @relation("AppointmentReschedule", fields: [tenantId, rescheduledFromId], references: [tenantId, id], onDelete: Restrict)
  rescheduledTo      Appointment?       @relation("AppointmentReschedule")
  planItem           PlanItem?          @relation(fields: [tenantId, planItemId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  events             AppointmentEvent[]
  encounters         Encounter[]
  planItemSessions   PlanItemSession[]

  @@unique([tenantId, id])
  /// Lets an encounter prove it belongs to the appointment's patient.
  @@unique([tenantId, id, patientId])
  /// At most one successor per rescheduled appointment.
  @@unique([tenantId, rescheduledFromId])
  @@index([tenantId])
  @@index([tenantId, branchId, startsAt])
  @@index([tenantId, dentistUserId, startsAt])
  @@index([tenantId, chairId, startsAt])
  @@index([tenantId, patientId, startsAt])
  @@index([tenantId, planItemId])
}

/// Append-only status history with actor attribution (UPDATE/DELETE revoked from the app role).
model AppointmentEvent {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  appointmentId String             @db.Uuid
  /// NULL for the creation event.
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  actorId       String
  reason        String?
  at            DateTime           @default(now()) @db.Timestamptz(3)
  appointment   Appointment        @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, appointmentId, at])
}

// ---------------------------------------------------------------------------------------------
// Clinical records: encounters, notes, amendments, odontogram, diagnoses, procedures
// ---------------------------------------------------------------------------------------------

/// OPEN -> SIGNED, never reopened (DB trigger). Only the treating dentist signs (DB CHECK).
/// Notes, diagnoses and procedures of a SIGNED encounter are immutable (DB trigger);
/// corrections are append-only ClinicalNoteAmendment rows. Never deleted.
model Encounter {
  id                    String                  @id @default(uuid()) @db.Uuid
  tenantId              String                  @db.Uuid
  patientId             String                  @db.Uuid
  branchId              String                  @db.Uuid
  /// At most one encounter per appointment; must be the same patient (composite FK).
  appointmentId         String?                 @db.Uuid
  /// Must be a tenant member when set (trigger).
  treatingDentistUserId String
  status                EncounterStatus         @default(OPEN)
  openedBy              String
  openedAt              DateTime                @default(now())
  signedAt              DateTime?
  signedBy              String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  patient               Patient                 @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  branch                Branch                  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  appointment           Appointment?            @relation(fields: [tenantId, appointmentId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  notes                 ClinicalNote[]
  amendments            ClinicalNoteAmendment[]
  toothRecords          ToothRecord[]
  diagnoses             Diagnosis[]
  procedures            ProcedureRecord[]
  documents             PatientDocument[]
  treatmentPlans        TreatmentPlan[]
  planItemSessions      PlanItemSession[]
  invoices              Invoice[]
  invoiceLines          InvoiceLine[]
  commissionEntries     CommissionEntry[]
  aiDrafts              AiDraft[]

  @@unique([tenantId, id])
  /// Lets clinical children prove they belong to the encounter's patient.
  @@unique([tenantId, id, patientId])
  @@unique([tenantId, appointmentId])
  @@index([tenantId])
  @@index([tenantId, patientId, openedAt])
  @@index([tenantId, branchId, status])
  @@index([tenantId, treatingDentistUserId, status])
}

/// Editable (and deletable) only while the encounter is OPEN — enforced by a DB trigger.
model ClinicalNote {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @db.Uuid
  encounterId String                  @db.Uuid
  kind        ClinicalNoteKind        @default(GENERAL)
  body        String
  authorId    String
  /// M4 (ADR 0005 §5): true when the text started as an AI draft that the author reviewed and approved.
  /// Set together with `aiDraftId` (DB CHECK); the draft is the evidence (provider, model, promptVersion).
  aiAssisted  Boolean                 @default(false)
  aiDraftId   String?                 @db.Uuid
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @default(now()) @updatedAt
  encounter   Encounter               @relation(fields: [tenantId, encounterId], references: [tenantId, id], onDelete: Restrict)
  aiDraft     AiDraft?                @relation("AiDraftNotes", fields: [tenantId, aiDraftId], references: [tenantId, id], onDelete: Restrict)
  amendments  ClinicalNoteAmendment[]

  @@unique([tenantId, id])
  /// Lets an amendment prove its note belongs to the same encounter.
  @@unique([tenantId, encounterId, id])
  @@index([tenantId])
  @@index([tenantId, aiDraftId])
}

/// Append-only correction of a SIGNED encounter (UPDATE/DELETE revoked; insert requires SIGNED).
/// `noteId` NULL = amendment of the encounter as a whole (e.g. a diagnosis correction).
model ClinicalNoteAmendment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  encounterId String        @db.Uuid
  noteId      String?       @db.Uuid
  body        String
  reason      String
  authorId    String
  createdAt   DateTime      @default(now())
  encounter   Encounter     @relation(fields: [tenantId, encounterId], references: [tenantId, id], onDelete: Restrict)
  note        ClinicalNote? @relation(fields: [tenantId, encounterId, noteId], references: [tenantId, encounterId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, encounterId])
  @@index([tenantId, noteId])
}

/// Odontogram entry: a condition on a tooth (surfaces empty) or on some of its surfaces.
/// History is preserved: change = mark the old row HISTORICAL (the only UPDATE the DB allows)
/// and insert a new CURRENT row. Never deleted. Snapshot = all CURRENT rows of the patient.
model ToothRecord {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  patientId    String            @db.Uuid
  encounterId  String?           @db.Uuid
  /// FDI two-digit code: permanent 11–18, 21–28, 31–38, 41–48; primary 51–55, 61–65, 71–75, 81–85 (DB CHECK).
  toothCode    Int               @db.SmallInt
  /// Must match the code (< 50 permanent) — DB CHECK.
  dentition    Dentition
  /// See @dentalos/validation `TOOTH_CONDITIONS` (text: catalogue still evolving, PRD 12.2).
  condition    String
  /// Subset of M,O,D,B,L,I,F,P valid for the tooth class (DB CHECK via fdi_valid_surfaces()).
  surfaces     String[]          @default([])
  notes        String?
  status       ToothRecordStatus @default(CURRENT)
  recordedBy   String
  recordedAt   DateTime          @default(now())
  supersededAt DateTime?
  supersededBy String?
  patient      Patient           @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  encounter    Encounter?        @relation(fields: [tenantId, encounterId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, patientId, status])
  @@index([tenantId, encounterId])
}

model Diagnosis {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  encounterId String    @db.Uuid
  patientId   String    @db.Uuid
  /// Coding system is open (ICD-10 / internal) — PRD 12.2.
  code        String
  label       String
  toothCode   Int?      @db.SmallInt
  surfaces    String[]  @default([])
  notes       String?
  diagnosedBy String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  patient     Patient   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  encounter   Encounter @relation(fields: [tenantId, encounterId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, encounterId])
  @@index([tenantId, patientId])
}

model ProcedureRecord {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  encounterId    String          @db.Uuid
  patientId      String          @db.Uuid
  serviceId      String?         @db.Uuid
  planItemId     String?         @db.Uuid
  /// Free text when no catalogue service applies.
  description    String?
  toothCode      Int?            @db.SmallInt
  surfaces       String[]        @default([])
  status         ProcedureStatus @default(COMPLETED)
  notes          String?
  performedBy    String
  performedAt    DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  patient        Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  encounter      Encounter       @relation(fields: [tenantId, encounterId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  service        Service?        @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  planItem       PlanItem?       @relation(fields: [tenantId, planItemId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  invoiceLines   InvoiceLine[]
  stockMovements StockMovement[]

  /// M3: lets invoice lines and stock consumption link a procedure (same tenant / same patient).
  @@unique([tenantId, id])
  @@unique([tenantId, id, patientId])
  @@index([tenantId])
  @@index([tenantId, encounterId])
  @@index([tenantId, patientId])
  @@index([tenantId, planItemId])
}

// ---------------------------------------------------------------------------------------------
// Treatment plans & consent
// ---------------------------------------------------------------------------------------------

/// Several plans per patient. `currentVersion` = latest TreatmentPlanVersion (0 = never presented).
/// Never deleted (cancel instead).
model TreatmentPlan {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @db.Uuid
  patientId      String                 @db.Uuid
  /// Branch whose effective prices the estimates were frozen at.
  branchId       String                 @db.Uuid
  encounterId    String?                @db.Uuid
  title          String
  notes          String?
  status         TreatmentPlanStatus    @default(DRAFT)
  currentVersion Int                    @default(0)
  presentedAt    DateTime?
  presentedBy    String?
  approvedAt     DateTime?
  approvedBy     String?
  cancelReason   String?
  createdBy      String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @default(now()) @updatedAt
  patient        Patient                @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  branch         Branch                 @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  encounter      Encounter?             @relation(fields: [tenantId, encounterId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  versions       TreatmentPlanVersion[]
  items          PlanItem[]
  invoices       Invoice[]

  @@unique([tenantId, id])
  /// Lets versions and items prove they belong to the plan's patient.
  @@unique([tenantId, id, patientId])
  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, branchId, status])
}

/// Append-only snapshot (UPDATE/DELETE revoked) taken on every change once the plan is presented.
model TreatmentPlanVersion {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  planId    String           @db.Uuid
  /// Copied from the plan (composite FK) so a consent can prove it is the same patient's version.
  patientId String           @db.Uuid
  version   Int
  /// @dentalos/validation `planSnapshot`: plan header + every item (status, frozen estimate) + totals.
  snapshot  Json
  reason    String?
  createdBy String
  createdAt DateTime         @default(now())
  plan      TreatmentPlan    @relation(fields: [tenantId, planId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  consents  PatientConsent[]
  aiDrafts  AiDraft[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, patientId])
  @@unique([tenantId, planId, version])
  @@index([tenantId])
}

/// One procedure in a plan. `estimatePricePaise` is the branch's effective catalogue price frozen
/// when the item was proposed (later catalogue changes never alter it).
model PlanItem {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  planId             String            @db.Uuid
  /// Copied from the plan (composite FK) so appointments, procedures and sessions linking this
  /// item must be the same patient's.
  patientId          String            @db.Uuid
  phase              Int               @default(1)
  sequence           Int               @default(1)
  serviceId          String            @db.Uuid
  toothCode          Int?              @db.SmallInt
  surfaces           String[]          @default([])
  quantity           Int               @default(1)
  /// Unit price in paise, frozen at proposal.
  estimatePricePaise Int
  /// "BASE" | "OVERRIDE" — where the frozen price came from.
  priceSource        String
  pricedAt           DateTime          @default(now())
  status             PlanItemStatus    @default(PROPOSED)
  notes              String?
  decidedAt          DateTime?
  decidedBy          String?
  decisionReason     String?
  createdBy          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
  plan               TreatmentPlan     @relation(fields: [tenantId, planId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  service            Service           @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  sessions           PlanItemSession[]
  appointments       Appointment[]
  procedures         ProcedureRecord[]
  invoiceLines       InvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, patientId])
  @@index([tenantId])
  @@index([tenantId, planId])
  @@index([tenantId, serviceId])
}

/// A sitting of a multi-session procedure (e.g. RCT visit 2 of 3). Never deleted (cancel instead).
model PlanItemSession {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  planItemId    String                @db.Uuid
  /// Copied from the item: the linked appointment and encounter must be the same patient's.
  patientId     String                @db.Uuid
  sessionNo     Int
  appointmentId String?               @db.Uuid
  encounterId   String?               @db.Uuid
  status        PlanItemSessionStatus @default(PLANNED)
  notes         String?
  createdBy     String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now()) @updatedAt
  planItem      PlanItem              @relation(fields: [tenantId, planItemId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  appointment   Appointment?          @relation(fields: [tenantId, appointmentId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  encounter     Encounter?            @relation(fields: [tenantId, encounterId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)

  @@unique([tenantId, planItemId, sessionNo])
  @@index([tenantId])
  @@index([tenantId, appointmentId])
  @@index([tenantId, encounterId])
}

/// Consent form template; its text lives in append-only versions. Deactivated, never deleted.
model ConsentTemplate {
  id             String                   @id @default(uuid()) @db.Uuid
  tenantId       String                   @db.Uuid
  /// Upper-case (DB CHECK), unique per tenant (e.g. "RCT-CONSENT").
  code           String
  type           ConsentTemplateType
  title          String
  active         Boolean                  @default(true)
  /// Latest published version (0 = none yet).
  currentVersion Int                      @default(0)
  createdBy      String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @default(now()) @updatedAt
  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  versions       ConsentTemplateVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Append-only (UPDATE/DELETE revoked). A signed PatientConsent references the exact version.
model ConsentTemplateVersion {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  templateId String           @db.Uuid
  version    Int
  body       String
  createdBy  String
  createdAt  DateTime         @default(now())
  template   ConsentTemplate  @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  consents   PatientConsent[]

  @@unique([tenantId, id])
  @@unique([tenantId, templateId, version])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------------------------
// M3 Billing: invoices, payments, refunds, adjustments, ledgers (ADR 0004 §1–§6)
// Money is integer paise. Posted financial records are never mutated to hide history: issued
// invoices are frozen (trigger), payments/allocations/adjustments/ledgers are append-only.
// ---------------------------------------------------------------------------------------------

/// Gap-free document numbering: one row per (branch, series, financial year), locked FOR UPDATE by
/// `allocate_document_seq()` inside the issuing transaction (a rollback gives the number back).
/// Series: INV invoice, CN credit note, DN debit note, RCP payment receipt.
model InvoiceCounter {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  branchId      String   @db.Uuid
  series        String   @default("INV")
  /// Indian financial year (Apr–Mar) as "25-26".
  financialYear String
  /// The NEXT sequence number to hand out (starts at 1).
  next          Int      @default(1)
  updatedAt     DateTime @default(now()) @updatedAt
  branch        Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, branchId, series, financialYear])
  @@index([tenantId])
}

/// Retry safety for append-only writes without a natural unique key (debit/credit notes, advance application and
/// adjustment, commission adjustments, settlements, stock receipts / consumption / adjustments / waste / transfers).
/// The service inserts a row FIRST in the same transaction (refType/refId = the id it pre-generated for the result);
/// a unique violation means "replay: answer with the stored refId, write nothing". Append-only (UPDATE/DELETE revoked).
/// No FK to Tenant (RLS isolates it, like the other ledgers' tenantId).
model RequestDedupe {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  /// e.g. "invoice.adjust", "stock.receive".
  scope          String
  idempotencyKey String
  /// SHA-256 of the canonical request body: a reused key with a different body is a 409 idempotency_conflict.
  requestHash    String?
  refType        String?
  refId          String?
  createdBy      String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, scope, idempotencyKey])
  @@index([tenantId])
}

/// DRAFT (editable, no number) -> ISSUED -> PARTIALLY_PAID -> PAID, or VOID (DRAFT / unpaid ISSUED only).
/// After issue everything except status, paidPaise, adjustmentPaise, balancePaise, dueDate, notes and the
/// void fields is frozen by trigger; corrections are InvoiceAdjustment rows. paid/balance/status are
/// maintained by triggers on PaymentAllocation and InvoiceAdjustment. Never deleted.
model Invoice {
  id                       String               @id @default(uuid()) @db.Uuid
  tenantId                 String               @db.Uuid
  branchId                 String               @db.Uuid
  patientId                String               @db.Uuid
  /// "BR1/25-26/000123"; NULL while DRAFT. Unique per tenant.
  number                   String?
  status                   InvoiceStatus        @default(DRAFT)
  issuedAt                 DateTime?            @db.Timestamptz(3)
  issuedBy                 String?
  dueDate                  DateTime?            @db.Date
  currency                 String               @default("INR")
  /// Whether line unit prices include GST (frozen at creation).
  taxInclusive             Boolean              @default(false)
  /// GST snapshot (supplier = the branch/tenant at issue). Place of supply decides CGST+SGST vs IGST.
  supplierGstin            String?
  supplierStateCode        String?
  placeOfSupplyStateCode   String?
  /// Σ line gross (quantity × unit price as entered), total discount (line + invoice level), Σ GST, payable total.
  subtotalPaise            Int
  discountPaise            Int                  @default(0)
  taxPaise                 Int                  @default(0)
  totalPaise               Int
  /// Invoice-level part of discountPaise (apportioned onto lines as allocatedDiscountPaise).
  invoiceDiscountPaise     Int                  @default(0)
  invoiceDiscountPercentBp Int?
  discountReason           String?
  discountAppliedBy        String?
  /// Net credit/debit notes: Σ debit − Σ credit (trigger).
  adjustmentPaise          Int                  @default(0)
  /// Σ allocations (net of refund reversals) (trigger).
  paidPaise                Int                  @default(0)
  /// totalPaise + adjustmentPaise − paidPaise (CHECK; trigger-maintained), never negative.
  balancePaise             Int
  /// Plan (and its version at invoicing) the estimate came from; NULL for ad hoc invoices.
  planId                   String?              @db.Uuid
  planVersion              Int?
  encounterId              String?              @db.Uuid
  notes                    String?
  voidReason               String?
  voidedBy                 String?
  voidedAt                 DateTime?            @db.Timestamptz(3)
  createdBy                String
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @default(now()) @updatedAt
  branch                   Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient                  Patient              @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  plan                     TreatmentPlan?       @relation(fields: [tenantId, planId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  encounter                Encounter?           @relation(fields: [tenantId, encounterId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  lines                    InvoiceLine[]
  allocations              PaymentAllocation[]
  refunds                  Refund[]
  adjustments              InvoiceAdjustment[]
  ledgerEntries            FinanceLedgerEntry[]
  commissionEntries        CommissionEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, patientId])
  /// Lets allocations prove payment and invoice share patient AND branch.
  @@unique([tenantId, id, patientId, branchId])
  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, planId])
}

/// Editable only while the invoice is DRAFT (trigger). Amounts are computed by @dentalos/validation `billing.ts`.
model InvoiceLine {
  id                     String            @id @default(uuid()) @db.Uuid
  tenantId               String            @db.Uuid
  invoiceId              String            @db.Uuid
  /// Copied from the invoice (composite FK): plan items, procedures and encounters must be the patient's.
  patientId              String            @db.Uuid
  lineNo                 Int
  serviceId              String?           @db.Uuid
  /// Category at invoicing time (snapshot) — commission rules filter on it.
  serviceCategoryId      String?           @db.Uuid
  description            String
  hsnSac                 String?
  quantity               Int               @default(1)
  unitPricePaise         Int
  /// quantity × unitPricePaise.
  grossPaise             Int
  /// Line-level discount (needs discount:apply + reason).
  discountPaise          Int               @default(0)
  discountReason         String?
  /// This line's share of the invoice-level discount.
  allocatedDiscountPaise Int               @default(0)
  /// Value on which GST is charged (ex-tax).
  taxableValuePaise      Int
  taxRateBp              Int               @default(0)
  cgstPaise              Int               @default(0)
  sgstPaise              Int               @default(0)
  igstPaise              Int               @default(0)
  /// taxableValuePaise + cgst + sgst + igst.
  totalPaise             Int
  planItemId             String?           @db.Uuid
  procedureRecordId      String?           @db.Uuid
  encounterId            String?           @db.Uuid
  /// Revenue attribution (PRD 2.5): the dentist who did the work. IdP subject, NOT a FK; guarded by
  /// tenant_member_guard on write. Never rewritten after a dentist transfer.
  dentistUserId          String?
  toothCode              Int?              @db.SmallInt
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @default(now()) @updatedAt
  invoice                Invoice           @relation(fields: [tenantId, invoiceId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  service                Service?          @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  serviceCategory        ServiceCategory?  @relation(fields: [tenantId, serviceCategoryId], references: [tenantId, id], onDelete: Restrict)
  planItem               PlanItem?         @relation(fields: [tenantId, planItemId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  procedureRecord        ProcedureRecord?  @relation(fields: [tenantId, procedureRecordId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  encounter              Encounter?        @relation(fields: [tenantId, encounterId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  commissionEntries      CommissionEntry[]
  patient                Patient           @relation(fields: [patientId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, id])
  @@unique([tenantId, invoiceId, lineNo])
  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, dentistUserId])
  @@index([tenantId, planItemId])
  @@index([tenantId, procedureRecordId])
}

/// Money received (or pending at a gateway). Money columns are immutable; the only updates are a PENDING
/// payment becoming RECORDED / FAILED (+ gatewayRef, receiptNumber, receivedAt) — column-level grant + trigger.
/// Never deleted. A payment is spent via PaymentAllocation rows; the unallocated rest is patient advance.
model Payment {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  branchId       String               @db.Uuid
  patientId      String               @db.Uuid
  method         PaymentMethod
  amountPaise    Int
  /// UPI txn id, cheque number, card last-4 + auth code, bank reference … never full card numbers.
  reference      String?
  receivedAt     DateTime             @default(now()) @db.Timestamptz(3)
  receivedBy     String
  /// Required on every payment request; unique per tenant (replay returns the original row).
  idempotencyKey String
  /// Provider id: "MANUAL" (recorded by staff) | "STUB" | a real gateway later.
  gateway        String               @default("MANUAL")
  gatewayRef     String?
  status         PaymentStatus        @default(RECORDED)
  /// Gap-free receipt number (series RCP), assigned when RECORDED.
  receiptNumber  String?
  failureCode    String?
  notes          String?
  createdAt      DateTime             @default(now())
  branch         Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient        Patient              @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  allocations    PaymentAllocation[]
  refunds        Refund[]
  ledgerEntries  FinanceLedgerEntry[]
  creditEntries  PatientCreditEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, patientId])
  @@unique([tenantId, id, patientId, branchId])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([tenantId, branchId, receivedAt])
  @@index([tenantId, patientId, receivedAt])
  @@index([tenantId, gateway, gatewayRef])
}

/// Append-only (UPDATE/DELETE revoked). amountPaise > 0 applies money to an invoice; < 0 is the reversal
/// written when a refund is processed against that invoice (refundId set). Payment and invoice must share
/// patient AND branch (composite FKs). Triggers keep Invoice.paid/balance/status in step.
model PaymentAllocation {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @db.Uuid
  paymentId         String               @db.Uuid
  invoiceId         String               @db.Uuid
  patientId         String               @db.Uuid
  branchId          String               @db.Uuid
  amountPaise       Int
  refundId          String?              @db.Uuid
  allocatedBy       String
  createdAt         DateTime             @default(now())
  payment           Payment              @relation(fields: [tenantId, paymentId, patientId, branchId], references: [tenantId, id, patientId, branchId], onDelete: Restrict)
  invoice           Invoice              @relation(fields: [tenantId, invoiceId, patientId, branchId], references: [tenantId, id, patientId, branchId], onDelete: Restrict)
  refund            Refund?              @relation(fields: [tenantId, refundId, paymentId], references: [tenantId, id, paymentId], onDelete: Restrict)
  branch            Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient           Patient              @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  commissionEntries CommissionEntry[]
  creditEntries     PatientCreditEntry[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, paymentId])
  @@index([tenantId, invoiceId])
}

/// Idempotent webhook processing: one row per (gateway, provider event id). Insert first; a unique
/// violation means "already processed" (ADR 0004 §5). Payload is not stored (hash only).
model PaymentGatewayEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  gateway     String
  eventId     String
  eventType   String
  /// SHA-256 of the raw body (tamper/duplicate diagnostics) — never the body itself.
  payloadHash String
  outcome     String
  receivedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, gateway, eventId])
  @@index([tenantId])
}

/// Refund of (part of) a payment: REQUESTED -> APPROVED -> PROCESSED, or REJECTED. Money columns are
/// immutable (trigger). With invoiceId set, processing writes a negative PaymentAllocation (invoice balance
/// goes back up); without, the refund comes out of the payment's unallocated advance. Never deleted.
model Refund {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  branchId        String               @db.Uuid
  patientId       String               @db.Uuid
  paymentId       String               @db.Uuid
  invoiceId       String?              @db.Uuid
  amountPaise     Int
  /// How the money goes back (usually the original payment's method).
  method          PaymentMethod
  reference       String?
  reason          String
  status          RefundStatus         @default(REQUESTED)
  requestedBy     String
  requestedAt     DateTime             @default(now()) @db.Timestamptz(3)
  approvedBy      String?
  approvedAt      DateTime?            @db.Timestamptz(3)
  rejectedBy      String?
  rejectedAt      DateTime?            @db.Timestamptz(3)
  rejectionReason String?
  processedBy     String?
  processedAt     DateTime?            @db.Timestamptz(3)
  idempotencyKey  String
  gateway         String               @default("MANUAL")
  gatewayRef      String?
  createdAt       DateTime             @default(now())
  payment         Payment              @relation(fields: [tenantId, paymentId, patientId, branchId], references: [tenantId, id, patientId, branchId], onDelete: Restrict)
  invoice         Invoice?             @relation(fields: [tenantId, invoiceId, patientId, branchId], references: [tenantId, id, patientId, branchId], onDelete: Restrict)
  branch          Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient         Patient              @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  allocations     PaymentAllocation[]
  ledgerEntries   FinanceLedgerEntry[]
  creditEntries   PatientCreditEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, paymentId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, paymentId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, patientId])
}

/// Credit / debit note against an ISSUED invoice (the only way to correct it). Append-only, gap-free
/// numbering (series CN / DN). amountPaise is tax-inclusive; taxPaise is the GST part for reporting.
model InvoiceAdjustment {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  branchId      String               @db.Uuid
  patientId     String               @db.Uuid
  invoiceId     String               @db.Uuid
  kind          AdjustmentKind
  number        String
  amountPaise   Int
  taxPaise      Int                  @default(0)
  reason        String
  issuedBy      String
  issuedAt      DateTime             @default(now()) @db.Timestamptz(3)
  invoice       Invoice              @relation(fields: [tenantId, invoiceId, patientId, branchId], references: [tenantId, id, patientId, branchId], onDelete: Restrict)
  branch        Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient       Patient              @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  ledgerEntries FinanceLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, branchId, issuedAt])
}

/// Append-only patient-account ledger (statements, branch/org revenue reporting). amountPaise is the effect on
/// what the patient owes: INVOICE +, INVOICE_VOID −, PAYMENT −, REFUND +, CREDIT_NOTE −, DEBIT_NOTE +.
/// Written by the billing service in the same transaction as the source row; never updated.
model FinanceLedgerEntry {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  branchId     String             @db.Uuid
  patientId    String             @db.Uuid
  kind         LedgerEntryKind
  amountPaise  Int
  invoiceId    String?            @db.Uuid
  paymentId    String?            @db.Uuid
  refundId     String?            @db.Uuid
  adjustmentId String?            @db.Uuid
  occurredAt   DateTime           @default(now()) @db.Timestamptz(3)
  createdBy    String
  branch       Branch             @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient      Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  invoice      Invoice?           @relation(fields: [tenantId, invoiceId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  payment      Payment?           @relation(fields: [tenantId, paymentId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  refund       Refund?            @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Restrict)
  adjustment   InvoiceAdjustment? @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, patientId, occurredAt])
  @@index([tenantId, branchId, occurredAt])
  @@index([tenantId, invoiceId])
}

/// Append-only advance/credit ledger per patient. ADVANCE + (unallocated payment money), APPLIED − (spent on an
/// invoice via an allocation), REFUNDED − (advance refunded), ADJUSTMENT ±. Balance = Σ amountPaise per patient,
/// never negative (trigger, serialised per patient).
model PatientCreditEntry {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  patientId    String             @db.Uuid
  branchId     String             @db.Uuid
  kind         CreditEntryKind
  amountPaise  Int
  paymentId    String?            @db.Uuid
  allocationId String?            @db.Uuid
  refundId     String?            @db.Uuid
  reason       String?
  createdBy    String
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  patient      Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  branch       Branch             @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  payment      Payment?           @relation(fields: [tenantId, paymentId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  allocation   PaymentAllocation? @relation(fields: [tenantId, allocationId], references: [tenantId, id], onDelete: Restrict)
  refund       Refund?            @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, patientId, createdAt])
}

// ---------------------------------------------------------------------------------------------
// M3 Dentist compensation (ADR 0004 §7). Rules are effective-dated and immutable once created (only
// closed); entries form an append-only ledger. Never silently change a historical commission basis.
// ---------------------------------------------------------------------------------------------

/// dentistUserId NULL = the default rule. One OPEN rule per (dentist-or-default, category-or-any) scope and no
/// overlapping periods per scope (exclusion constraint). Precedence: dentist+category > dentist >
/// default+category > default. Never deleted.
model CommissionRule {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  dentistUserId     String?
  type              CommissionRuleType @default(PERCENT_OF_COLLECTED)
  /// 0–10000 (basis points) for PERCENT_* types.
  percentBp         Int?
  /// Paise per procedure unit for FIXED_PER_PROCEDURE.
  fixedPaise        Int?
  serviceCategoryId String?            @db.Uuid
  effectiveFrom     DateTime           @db.Date
  /// Exclusive. NULL = open.
  effectiveTo       DateTime?          @db.Date
  note              String?
  createdBy         String
  createdAt         DateTime           @default(now())
  endedBy           String?
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  serviceCategory   ServiceCategory?   @relation(fields: [tenantId, serviceCategoryId], references: [tenantId, id], onDelete: Restrict)
  entries           CommissionEntry[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, dentistUserId])
}

/// Append-only commission ledger (UPDATE/DELETE revoked). amountPaise is signed: ACCRUAL +, REVERSAL −
/// (refund), ADJUSTMENT ±, SETTLEMENT − (pay-out). baseAmountPaise is the (ex-tax) revenue the rule was applied to.
/// The attributed dentist is copied from InvoiceLine.dentistUserId and never rewritten.
model CommissionEntry {
  id                  String                    @id @default(uuid()) @db.Uuid
  tenantId            String                    @db.Uuid
  branchId            String                    @db.Uuid
  /// IdP subject (not a FK, not member-guarded: a removed dentist still earns on old work).
  dentistUserId       String
  kind                CommissionEntryKind
  amountPaise         Int
  baseAmountPaise     Int                       @default(0)
  ruleId              String?                   @db.Uuid
  invoiceId           String?                   @db.Uuid
  invoiceLineId       String?                   @db.Uuid
  paymentAllocationId String?                   @db.Uuid
  encounterId         String?                   @db.Uuid
  settlementId        String?                   @db.Uuid
  reason              String?
  createdBy           String
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  branch              Branch                    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  rule                CommissionRule?           @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: Restrict)
  invoice             Invoice?                  @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  invoiceLine         InvoiceLine?              @relation(fields: [tenantId, invoiceId, invoiceLineId], references: [tenantId, invoiceId, id], onDelete: Restrict)
  allocation          PaymentAllocation?        @relation(fields: [tenantId, paymentAllocationId], references: [tenantId, id], onDelete: Restrict)
  encounter           Encounter?                @relation(fields: [tenantId, encounterId], references: [tenantId, id], onDelete: Restrict)
  settlement          CommissionSettlement?     @relation("SettlementPayout", fields: [tenantId, settlementId], references: [tenantId, id], onDelete: Restrict)
  settlementItem      CommissionSettlementItem?

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, dentistUserId, createdAt])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, invoiceId])
  @@index([tenantId, paymentAllocationId])
}

/// Settlement run for one dentist and period [periodStart, periodEnd): DRAFT -> APPROVED -> PAID (trigger).
/// No overlapping periods per dentist (exclusion constraint). Only a DRAFT may be discarded.
model CommissionSettlement {
  id               String                     @id @default(uuid()) @db.Uuid
  tenantId         String                     @db.Uuid
  dentistUserId    String
  periodStart      DateTime                   @db.Date
  periodEnd        DateTime                   @db.Date
  status           SettlementStatus           @default(DRAFT)
  /// Σ item amounts (frozen at approval).
  totalPaise       Int                        @default(0)
  createdBy        String
  createdAt        DateTime                   @default(now())
  approvedBy       String?
  approvedAt       DateTime?                  @db.Timestamptz(3)
  paidBy           String?
  paidAt           DateTime?                  @db.Timestamptz(3)
  paymentReference String?
  notes            String?
  tenant           Tenant                     @relation(fields: [tenantId], references: [id])
  items            CommissionSettlementItem[]
  payoutEntries    CommissionEntry[]          @relation("SettlementPayout")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, dentistUserId, status])
}

/// Which ledger entries a settlement covers; an entry is settled at most once (unique). Deletable only
/// while the parent settlement is DRAFT.
model CommissionSettlementItem {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid
  settlementId String               @db.Uuid
  entryId      String               @db.Uuid
  amountPaise  Int
  settlement   CommissionSettlement @relation(fields: [tenantId, settlementId], references: [tenantId, id], onDelete: Restrict)
  entry        CommissionEntry      @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, entryId])
  @@index([tenantId])
  @@index([tenantId, settlementId])
}

// ---------------------------------------------------------------------------------------------
// M3 Inventory (ADR 0004 §8): items, suppliers, receipts, append-only stock ledger with a
// trigger-maintained balance (weighted-average cost), inter-branch transfers.
// ---------------------------------------------------------------------------------------------

model InventoryItem {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  /// Upper-case (DB CHECK), unique per tenant.
  sku           String
  name          String
  category      String?
  unit          InventoryUnit       @default(PIECE)
  /// Low-stock when a branch balance is at or below this.
  reorderLevel  Decimal             @default(0) @db.Decimal(14, 3)
  costingMethod CostingMethod       @default(WEIGHTED_AVERAGE)
  /// Track batch number / expiry on receipts and consume first-expiry-first-out.
  tracksBatches Boolean             @default(false)
  /// Allow the branch balance to go below zero (otherwise the stock trigger refuses).
  allowOverdraw Boolean             @default(false)
  active        Boolean             @default(true)
  createdBy     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  movements     StockMovement[]
  balances      StockBalance[]
  transferLines StockTransferLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, active])
}

model Supplier {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  name        String
  contactName String?
  phone       String?
  email       String?
  gstin       String?
  address     String?
  notes       String?
  active      Boolean        @default(true)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  receipts    StockReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
}

/// A simple purchase receipt (header). The stock lines are RECEIPT StockMovement rows. Append-only.
model StockReceipt {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  branchId       String          @db.Uuid
  supplierId     String?         @db.Uuid
  /// Supplier's invoice / challan number.
  reference      String?
  receivedOn     DateTime        @db.Date
  totalCostPaise Int?
  notes          String?
  createdBy      String
  createdAt      DateTime        @default(now())
  branch         Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  supplier       Supplier?       @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  movements      StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, id])
  @@index([tenantId])
  @@index([tenantId, branchId, receivedOn])
}

/// Append-only stock ledger (UPDATE/DELETE revoked). quantity is signed (RECEIPT/TRANSFER_IN +, CONSUMPTION/
/// TRANSFER_OUT/WASTE −, ADJUSTMENT ±). A BEFORE INSERT trigger updates StockBalance atomically, refuses a
/// negative balance unless the item allows overdraw, fills unitCostPaise for outflows from the weighted
/// average, and sets balanceAfter.
model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  branchId          String            @db.Uuid
  itemId            String            @db.Uuid
  kind              StockMovementKind
  quantity          Decimal           @db.Decimal(14, 3)
  /// Paise per unit (fractions allowed: ₹0.37/ml). Required on RECEIPT; filled by the trigger otherwise.
  unitCostPaise     Decimal?          @db.Decimal(14, 4)
  batchNo           String?
  expiryDate        DateTime?         @db.Date
  receiptId         String?           @db.Uuid
  transferId        String?           @db.Uuid
  procedureRecordId String?           @db.Uuid
  /// Free link for other sources (e.g. "STOCK_COUNT").
  refType           String?
  refId             String?
  /// Required for ADJUSTMENT and WASTE (DB CHECK).
  reason            String?
  createdBy         String
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  /// Branch balance right after this movement (trigger).
  balanceAfter      Decimal?          @db.Decimal(14, 3)
  branch            Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  item              InventoryItem     @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  receipt           StockReceipt?     @relation(fields: [tenantId, branchId, receiptId], references: [tenantId, branchId, id], onDelete: Restrict)
  transfer          StockTransfer?    @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Restrict)
  procedureRecord   ProcedureRecord?  @relation(fields: [tenantId, procedureRecordId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, branchId, itemId, createdAt])
  @@index([tenantId, branchId, itemId, expiryDate])
  @@index([tenantId, procedureRecordId])
  @@index([tenantId, transferId])
}

/// Current stock per (branch, item) — written ONLY by the StockMovement trigger (SECURITY DEFINER; the app
/// role has SELECT only). avgUnitCostPaise is the weighted-average cost.
model StockBalance {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  branchId         String        @db.Uuid
  itemId           String        @db.Uuid
  quantity         Decimal       @default(0) @db.Decimal(14, 3)
  avgUnitCostPaise Decimal       @default(0) @db.Decimal(14, 4)
  updatedAt        DateTime      @default(now()) @updatedAt
  branch           Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  item             InventoryItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, branchId, itemId])
  @@index([tenantId])
  @@index([tenantId, itemId])
}

/// Inter-branch transfer: IN_TRANSIT (TRANSFER_OUT rows written at send) -> RECEIVED (TRANSFER_IN rows at
/// receipt). Never deleted. Lines are written once; receivedQuantity is set on receipt.
model StockTransfer {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  fromBranchId String              @db.Uuid
  toBranchId   String              @db.Uuid
  status       StockTransferStatus @default(IN_TRANSIT)
  notes        String?
  sentBy       String
  sentAt       DateTime            @default(now()) @db.Timestamptz(3)
  receivedBy   String?
  receivedAt   DateTime?           @db.Timestamptz(3)
  fromBranch   Branch              @relation("TransferFrom", fields: [tenantId, fromBranchId], references: [tenantId, id], onDelete: Restrict)
  toBranch     Branch              @relation("TransferTo", fields: [tenantId, toBranchId], references: [tenantId, id], onDelete: Restrict)
  lines        StockTransferLine[]
  movements    StockMovement[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, fromBranchId, status])
  @@index([tenantId, toBranchId, status])
}

model StockTransferLine {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  transferId       String        @db.Uuid
  itemId           String        @db.Uuid
  quantity         Decimal       @db.Decimal(14, 3)
  batchNo          String?
  expiryDate       DateTime?     @db.Date
  /// Weighted-average cost at the source when sent (carried to the destination as the receipt cost).
  unitCostPaise    Decimal?      @db.Decimal(14, 4)
  receivedQuantity Decimal?      @db.Decimal(14, 3)
  transfer         StockTransfer @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Restrict)
  item             InventoryItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, transferId])
}

// ---------------------------------------------------------------------------------------------
// M3 Notifications (ADR 0004 §9): versioned templates, outbox, delivery events, recall intervals.
// ---------------------------------------------------------------------------------------------

/// code + channel + language identify a template; its text lives in append-only versions. Deactivated,
/// never deleted. Channels reuse the M1 `CommChannel` enum.
model NotificationTemplate {
  id             String                        @id @default(uuid()) @db.Uuid
  tenantId       String                        @db.Uuid
  /// Upper-case (DB CHECK), e.g. "APPT_REMINDER_24H".
  code           String
  channel        CommChannel
  /// BCP-47-ish, lower-case ("en", "hi").
  language       String                        @default("en")
  purpose        CommPurpose                   @default(TRANSACTIONAL)
  name           String
  active         Boolean                       @default(true)
  currentVersion Int                           @default(0)
  createdBy      String
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @default(now()) @updatedAt
  tenant         Tenant                        @relation(fields: [tenantId], references: [id])
  versions       NotificationTemplateVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, code, channel, language])
  @@index([tenantId])
}

/// Append-only (UPDATE/DELETE revoked). `{{placeholder}}` body; an outbox row pins the exact version.
model NotificationTemplateVersion {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @db.Uuid
  templateId          String               @db.Uuid
  version             Int
  subject             String?
  body                String
  /// Provider-approved template name (WhatsApp templates must be pre-approved).
  providerTemplateRef String?
  createdBy           String
  createdAt           DateTime             @default(now())
  template            NotificationTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  outbox              NotificationOutbox[]

  @@unique([tenantId, id])
  @@unique([tenantId, templateId, version])
  @@index([tenantId])
}

/// One row per message to send (or deliberately not sent). `toAddress` is the normalised phone / e-mail —
/// personal data needed to send, protected by RLS and never copied into job payloads, logs or audit.
/// Identity/content columns are immutable; the worker only advances status/attempt/provider columns (trigger).
model NotificationOutbox {
  id                String                      @id @default(uuid()) @db.Uuid
  tenantId          String                      @db.Uuid
  branchId          String?                     @db.Uuid
  patientId         String?                     @db.Uuid
  channel           CommChannel
  purpose           CommPurpose
  templateCode      String
  templateVersionId String                      @db.Uuid
  toAddress         String
  /// Placeholder values for the template (display strings only — no clinical content).
  variables         Json                        @default("{}")
  status            NotificationStatus          @default(QUEUED)
  attempts          Int                         @default(0)
  /// Not before (reminders are scheduled; quiet hours push it to the next allowed time).
  scheduledFor      DateTime                    @default(now()) @db.Timestamptz(3)
  nextAttemptAt     DateTime?                   @db.Timestamptz(3)
  idempotencyKey    String
  provider          String?
  providerMessageId String?
  /// Provider-reported delivery state (e.g. delivered, read, failed).
  deliveryStatus    String?
  deliveredAt       DateTime?                   @db.Timestamptz(3)
  /// Error code / short message without personal data (≤ 500 chars, DB CHECK).
  lastError         String?
  /// What triggered it, e.g. "appointment.reminder.24h" | "invoice.issued".
  source            String
  refType           String?
  refId             String?
  actorId           String
  createdAt         DateTime                    @default(now()) @db.Timestamptz(3)
  sentAt            DateTime?                   @db.Timestamptz(3)
  updatedAt         DateTime                    @default(now()) @updatedAt
  branch            Branch?                     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient           Patient?                    @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  templateVersion   NotificationTemplateVersion @relation(fields: [tenantId, templateVersionId], references: [tenantId, id], onDelete: Restrict)
  deliveryEvents    NotificationDeliveryEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, provider, providerMessageId])
  @@index([tenantId, refType, refId])
}

/// Append-only log of provider delivery receipts (webhook) for one outbox row.
model NotificationDeliveryEvent {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  outboxId          String             @db.Uuid
  status            String
  providerMessageId String?
  errorCode         String?
  occurredAt        DateTime           @default(now()) @db.Timestamptz(3)
  outbox            NotificationOutbox @relation(fields: [tenantId, outboxId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, outboxId, occurredAt])
}

/// Recall reminder interval per service (days after a completed procedure). Deactivated, never deleted.
model RecallSetting {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  serviceId    String   @db.Uuid
  intervalDays Int
  active       Boolean  @default(true)
  updatedBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  service      Service  @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, serviceId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------------------------
// M4 Patient portal (ADR 0005 §1-§3). A portal login is NEVER a staff Membership: it is a
// PatientPortalAccount bound to exactly one patient of one tenant. Every portal read/write is scoped
// by the patientId resolved from the verified session, never from client input.
// ---------------------------------------------------------------------------------------------

/// One account per patient per tenant. Created by staff (invite) only for a patient whose identity staff
/// VERIFIED and who is not merged (trigger). Login destinations are normalised (@dentalos/validation
/// normalisers) and NOT unique: one phone/e-mail may match several patients of the tenant (picker).
model PatientPortalAccount {
  id            String                   @id @default(uuid()) @db.Uuid
  tenantId      String                   @db.Uuid
  patientId     String                   @db.Uuid
  status        PortalAccountStatus      @default(INVITED)
  /// E.164 / lower-case e-mail the patient logs in with (at least one, CHECK).
  loginPhone    String?
  loginEmail    String?
  /// Staff member (IdP subject) who sent the invite; must be a current member when written.
  invitedBy     String
  invitedAt     DateTime                 @default(now()) @db.Timestamptz(3)
  activatedAt   DateTime?                @db.Timestamptz(3)
  suspendedAt   DateTime?                @db.Timestamptz(3)
  suspendedBy   String?
  suspendReason String?
  lastLoginAt   DateTime?                @db.Timestamptz(3)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @default(now()) @updatedAt
  patient       Patient                  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  otps          PortalOtp[]
  sessions      PortalSession[]
  signatures    PortalConsentSignature[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, patientId])
  @@unique([tenantId, patientId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, loginPhone])
  @@index([tenantId, loginEmail])
}

/// One-time code. Only HMAC hashes are stored (destination and code). Columns other than
/// `attempts` / `consumedAt` are immutable (column grants + trigger); never deleted by the app role.
/// `accountId` is NULL for LOGIN / ACTIVATE requests (resolved from the destination when verified).
model PortalOtp {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  accountId       String?               @db.Uuid
  purpose         PortalOtpPurpose
  channel         CommChannel
  /// HMAC-SHA256(pepper, normalised destination), hex. Rate limits count rows per hash.
  destinationHash String
  /// HMAC-SHA256(pepper, otpId + ":" + code), hex.
  codeHash        String
  /// Step-up binding, e.g. "consent" / plan version id: the code only authorises that action.
  subjectType     String?
  subjectId       String?
  attempts        Int                   @default(0)
  maxAttempts     Int                   @default(5)
  expiresAt       DateTime              @db.Timestamptz(3)
  consumedAt      DateTime?             @db.Timestamptz(3)
  /// HMAC of the caller IP (rate limit per IP); never the raw address.
  ipHash          String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  account         PatientPortalAccount? @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, destinationHash, createdAt])
  @@index([tenantId, ipHash, createdAt])
  @@index([tenantId, accountId, purpose, createdAt])
}

/// Refresh-token session with rotation. `refreshTokenHash` = SHA-256 of the opaque refresh token. A
/// rotation inserts a successor (same `familyId`, `rotatedFromId`) and revokes the old row; presenting a
/// revoked refresh token revokes the whole family (theft detection). `(tenantId, accountId, patientId)`
/// binds the session to the account's patient. New sessions need an ACTIVE account (trigger).
model PortalSession {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @db.Uuid
  accountId        String               @db.Uuid
  patientId        String               @db.Uuid
  familyId         String               @db.Uuid
  rotatedFromId    String?              @db.Uuid
  refreshTokenHash String               @unique
  userAgentHash    String?
  ipHash           String?
  /// Last successful step-up OTP in this session (consent / plan approval need a recent one).
  stepUpAt         DateTime?            @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime             @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime             @db.Timestamptz(3)
  revokedAt        DateTime?            @db.Timestamptz(3)
  revokedReason    String?
  account          PatientPortalAccount @relation(fields: [tenantId, accountId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  rotatedFrom      PortalSession?       @relation("PortalSessionRotation", fields: [tenantId, rotatedFromId], references: [tenantId, id], onDelete: Restrict)
  rotatedTo        PortalSession?       @relation("PortalSessionRotation")

  @@unique([tenantId, id])
  @@unique([tenantId, rotatedFromId])
  @@index([tenantId])
  @@index([tenantId, accountId, revokedAt])
  @@index([tenantId, familyId])
}

/// Evidence of a patient's typed-name e-signature given in the portal (append-only). The signed
/// `PatientConsent` row is written by the normal consent path (method DIGITAL); this row proves who
/// signed it, with which session, exactly which text (`bodySha256`) and after which OTP step-up
/// (`signedAt - otpVerifiedAt <= 15 min`, CHECK). One signature per consent.
model PortalConsentSignature {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  patientId     String               @db.Uuid
  accountId     String               @db.Uuid
  sessionId     String               @db.Uuid
  consentId     String               @db.Uuid
  typedName     String
  /// SHA-256 (hex) of the exact consent text shown to the patient.
  bodySha256    String
  otpVerifiedAt DateTime             @db.Timestamptz(3)
  signedAt      DateTime             @default(now()) @db.Timestamptz(3)
  ipHash        String?
  userAgentHash String?
  account       PatientPortalAccount @relation(fields: [tenantId, accountId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  consent       PatientConsent       @relation(fields: [tenantId, consentId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  patient       Patient              @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, consentId])
  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, accountId])
}

// ---------------------------------------------------------------------------------------------
// M4 AI (ADR 0005 §5). Provider-agnostic; every output is an AiDraft that a human reviews.
// ---------------------------------------------------------------------------------------------

/// Per tenant per capability switch. No row = disabled (default off). `allowedRoles` never contains PATIENT.
/// `monthlyQuota` NULL = the plan default resolved by the service; 0 = no calls.
model AiSetting {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  /// @dentalos/validation `AI_CAPABILITIES` (text so the catalogue can grow without a migration).
  capability    String
  enabled       Boolean  @default(false)
  allowedRoles  Role[]   @default([])
  monthlyQuota  Int?
  /// When true the activity log may keep prompt/response content for this capability (default: never).
  retainContent Boolean  @default(false)
  updatedBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, capability])
  @@index([tenantId])
}

/// Monthly usage counter per capability; the service upserts with increments inside the call's transaction.
/// `month` = first day of the month in the tenant's default time zone (CHECK day = 1).
model AiUsage {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  month            DateTime @db.Date
  capability       String
  requestCount     Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, month, capability])
  @@index([tenantId])
}

/// Append-only (UPDATE/DELETE revoked) record of AI activity (PRD 5.7): who, scope, feature, provider /
/// model, action, approval, outcome, token counts. Prompt / response content is NOT stored unless the
/// capability's `retainContent` is on (then `content`).
model AiActivityLog {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  /// Staff IdP subject, or "system" for jobs. Not a FK (removed members keep their history).
  actorId          String
  /// "ORG" | "BRANCH" | "PATIENT": the permitted scope the data was retrieved under.
  scope            String
  branchId         String?  @db.Uuid
  patientId        String?  @db.Uuid
  capability       String
  provider         String
  model            String
  /// "generate" | "transcribe" | "query" | "summarise" | "approve" | "reject" | "expire" | "proposal" | "refuse"
  action           String
  draftId          String?  @db.Uuid
  /// "APPROVED" | "REJECTED" | null (nothing to approve yet).
  approval         String?
  /// "success" | "refused" | "error" | "quota_exceeded" | "disabled" | "denied"
  outcome          String
  errorCode        String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  latencyMs        Int?
  /// Whether the prompt was de-identified before leaving the platform.
  deidentified     Boolean  @default(false)
  content          Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  branch           Branch?  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient          Patient? @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  draft            AiDraft? @relation(fields: [tenantId, draftId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, capability, createdAt])
  @@index([tenantId, actorId, createdAt])
}

/// AI output awaiting human review. DRAFT -> APPROVED | REJECTED | EXPIRED exactly once (trigger
/// `ai_draft_guard`); after that everything is frozen. `metadata` carries { provider, model, promptVersion }
/// (CHECK) for the visible "AI-generated" label. Approving a CLINICAL_NOTE / VOICE_NOTE draft requires the
/// resulting ClinicalNote rows (`ClinicalNote.aiDraftId`) written by the approving dentist in the same
/// transaction; a signed encounter refuses them (M2 trigger).
model AiDraft {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @db.Uuid
  kind                AiDraftKind
  /// "patient" | "encounter" | "plan_version" | "appointment" | "analytics"
  subjectType         String
  subjectId           String
  patientId           String?               @db.Uuid
  branchId            String                @db.Uuid
  encounterId         String?               @db.Uuid
  planVersionId       String?               @db.Uuid
  status              AiDraftStatus         @default(DRAFT)
  /// Per-kind JSON shape (@dentalos/validation `aiDraftContent`).
  content             Json
  metadata            Json
  createdBy           String
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  editedBy            String?
  editedAt            DateTime?             @db.Timestamptz(3)
  reviewedBy          String?
  reviewedAt          DateTime?             @db.Timestamptz(3)
  reviewNote          String?
  /// e.g. "ClinicalNote" + the anchor note id (the first note written on approval).
  resultingRecordType String?
  resultingRecordId   String?               @db.Uuid
  expiresAt           DateTime              @db.Timestamptz(3)
  updatedAt           DateTime              @default(now()) @updatedAt
  patient             Patient?              @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  branch              Branch                @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  encounter           Encounter?            @relation(fields: [tenantId, encounterId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  planVersion         TreatmentPlanVersion? @relation(fields: [tenantId, planVersionId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  notes               ClinicalNote[]        @relation("AiDraftNotes")
  activity            AiActivityLog[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, branchId, status])
  @@index([tenantId, patientId, kind])
  @@index([tenantId, encounterId])
  @@index([tenantId, planVersionId])
}

// ---------------------------------------------------------------------------------------------
// M4 Analytics (ADR 0005 §4)
// ---------------------------------------------------------------------------------------------

/// Daily branch summary written by the snapshot job: numbers from the analytics queries + an optional
/// AI narrative generated FROM those numbers (labelled via `aiSummaryMeta`). One row per branch and
/// branch-local day; recomputing the same day updates the row.
model AnalyticsSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  branchId      String   @db.Uuid
  /// Branch-local calendar day.
  day           DateTime @db.Date
  /// @dentalos/validation `branchDailyMetrics`.
  metrics       Json
  aiSummary     String?
  /// { provider, model, promptVersion } when `aiSummary` is set.
  aiSummaryMeta Json?
  generatedAt   DateTime @default(now()) @db.Timestamptz(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  branch        Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, day])
  @@index([tenantId])
  @@index([tenantId, day])
}

# ─────────────────────────────────────────────────────────────────────────────
# DentalOS local configuration.
#
# SETUP:  cp .env.example .env     (the file must be named exactly `.env`, at the REPO ROOT:
#         the same folder as package.json. It is git-ignored, so secrets stay on your machine.)
# One file serves the API, worker, database scripts and staff-web.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (local Postgres from `bun run db:up`, port 5433) ───────────────
# App role used by the running API: row-level security applies to it.
DATABASE_URL=postgresql://dentalos_app:dentalos_app@localhost:5433/dentalos
# Superuser, used ONLY for migrations (`bun run db:migrate`) and the demo seed.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dentalos

# ── API ─────────────────────────────────────────────────────────────────────
PORT=3001
LOG_LEVEL=info
# Local dev token signing secret. Required. Generate with:  openssl rand -hex 32
DEV_JWT_SECRET=
# Lifetime of tokens minted by `bun run db:seed` (e.g. 7d, 12h).
DEV_TOKEN_TTL=7d

# S3-compatible storage (SeaweedFS from `bun run db:up`). Needed only for document uploads.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=dentalos-dev
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
AWS_REGION=ap-south-1

# ── Background jobs (pg-boss) ────────────────────────────────────────────────
# The worker installs / migrates the `pgboss` schema, which the app role cannot do. It connects with
# PGBOSS_DATABASE_URL, falling back to ADMIN_DATABASE_URL (the local default), then grants the app role access so the
# API can enqueue. In production set PGBOSS_DATABASE_URL to a dedicated schema-owner role.
# PGBOSS_DATABASE_URL=
# PGBOSS_APP_ROLE=dentalos_app

# ── Inbound webhooks (payment gateway, SMS / WhatsApp / email delivery receipts) ─
# HMAC-SHA256 secrets, matched per gateway and tenant (packages/config webhook-secrets.ts). Comma-separate several
# values while rotating. A missing secret makes the webhook route answer 401. Examples (generate: openssl rand -hex 32):
# WEBHOOK_SECRET_STUB=
# WEBHOOK_SECRET_STUB_<TENANT_UUID_UPPERCASE_WITH_UNDERSCORES>=

# Optional: send traces to an OpenTelemetry collector. Leave empty to disable.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Staff web (Next.js, http://localhost:3000) ──────────────────────────────
# Where the Next server forwards /api-proxy/* requests (keep as-is for local dev).
API_INTERNAL_URL=http://localhost:3001
# Browser -> API path. Keep as /api-proxy. Leave empty to use built-in fixture data (no API).
NEXT_PUBLIC_API_URL=/api-proxy
NEXT_PUBLIC_API_MOCK=0

# Dev login (no Cognito yet). `bun run db:seed [-- --role=MANAGER]` fills the NEXT_PUBLIC_DEV_* lines below:
NEXT_PUBLIC_DEV_ROLE=OWNER
NEXT_PUBLIC_DEV_TENANT_ID=
NEXT_PUBLIC_DEV_BRANCH_ID=
NEXT_PUBLIC_DEV_USER_ID=dev-user
NEXT_PUBLIC_DEV_TOKEN=
# Allows the dev login (no Cognito) when running `next build` / `next start`.
DENTALOS_AUTH_MODE=dev

# ── Real sign-in (Cognito). Leave ALL blank for local dev. ──────────────────
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_USER_POOL_ID=
COGNITO_REGION=
APP_URL=
SESSION_SECRET=

# ── M4: patient portal (ADR 0005) ───────────────────────────────────────────
# Portal tokens use their OWN key and OTP hashes their own pepper. Unset in development: both are derived from
# DEV_JWT_SECRET. REQUIRED in production (>= 32 chars each; PORTAL_JWT_SECRET must differ from any staff secret:
# generate with `openssl rand -hex 32`). Without them the portal routes fail closed; the staff API still starts.
# PORTAL_JWT_SECRET=
# PORTAL_OTP_PEPPER=
# Patient portal (Next.js, http://localhost:3002). Same-origin /api-proxy rewrite to the API, like staff-web.
# PORTAL_API_URL=http://localhost:3001
# The clinic a single-tenant portal deployment signs patients in to (public id; or use /t/<tenantId> in the URL).
# PORTAL_TENANT_ID=
# Public base URL used in invite links and payment return URLs.
# PORTAL_PUBLIC_URL=http://localhost:3002

# ── M4: AI (ADR 0005 §5). OFF unless AI_PROVIDER is set. ────────────────────
# AI_PROVIDER=stub                  # deterministic, no network (demos / local)
# AI_PROVIDER=openai-compatible     # a chat-completions style endpoint; needs the three values below
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_STT_MODEL=                     # speech-to-text model (default: AI_MODEL)
# Set to true ONLY after the provider's region and contract were validated for India-only processing (PRD 5.6, 7.1).
# Without it, free-text clinical capabilities are refused for this provider.
# AI_REGION_COMPLIANT=false

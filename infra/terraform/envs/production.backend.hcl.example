# Copy to envs/production.backend.hcl using the output of: terraform -chdir=infra/terraform/bootstrap apply -var env=production
bucket         = "dentalos-production-tfstate-<account-id>"
key            = "stack/terraform.tfstate"
region         = "ap-south-1"
dynamodb_table = "dentalos-production-tflock"
encrypt        = true
kms_key_id     = "<state kms key arn>"

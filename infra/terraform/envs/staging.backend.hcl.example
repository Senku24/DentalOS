# Copy to envs/staging.backend.hcl using the output of: terraform -chdir=infra/terraform/bootstrap apply -var env=staging
bucket         = "dentalos-staging-tfstate-<account-id>"
key            = "stack/terraform.tfstate"
region         = "ap-south-1"
dynamodb_table = "dentalos-staging-tflock"
encrypt        = true
kms_key_id     = "<state kms key arn>"
